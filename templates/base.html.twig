<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>


    <link rel="stylesheet" href="https://bootswatch.com/5/vapor/bootstrap.min.css">


    {% block stylesheets %}
       
<style>
    html, body {
        height: 100%;
    }


    body {
        min-height: 100vh;
        padding-top: 0;
        display: flex;
        flex-direction: column;
    }


    main {
        flex: 1;
    }
    .competence-card {
    background-color: rgba(255, 255, 255, 0.05);
    border: 2px solid cyan;
    border-radius: 16px;
    padding: 2.5rem 1.5rem;
    text-align: center;
    transition: transform 0.2s, background-color 0.2s;
    cursor: pointer;
    min-height: 180px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.competence-card:hover {
    transform: translateY(-6px);
    background-color: rgba(0, 255, 255, 0.08);
}

.competence-card h4 {
    color: cyan;
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
}

.competence-card p {
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    font-size: 1rem;
}
/* Compétence page */
.competence-titre {
    color: cyan;
    font-size: 2rem;
}

.competence-sous-titre {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.1rem;
    font-weight: 400;
}

/* Carte SAE */
.sae-card {
    background-color: rgba(255, 255, 255, 0.05);
    border: 2px solid cyan;
    border-radius: 16px;
    padding: 2.5rem;
    max-width: 860px;
}

.sae-titre {
    color: cyan;
    font-size: 1.8rem;
}

.sae-image-wrapper {
    text-align: center;
}

.sae-image {
    max-width: 100%;
    border-radius: 10px;
    border: 1px solid rgba(0, 255, 255, 0.3);
}

.sae-description p {
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.8;
}

.sae-liste {
    color: rgba(255, 255, 255, 0.85);
    line-height: 2;
    padding-left: 1.5rem;
}

.ac-highlight {
    color: cyan;
}
/* Pages AC */
.ac-section {
    margin-bottom: 1.5rem;
}

.ac-section-titre {
    color: cyan;
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 1rem;
}

.ac-sous-titre {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
}

.ac-divider {
    border-color: rgba(0, 255, 255, 0.2);
    margin: 2rem 0;
}

.ac-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
}

.ac-table th {
    border-bottom: 1px solid rgba(0, 255, 255, 0.4);
    padding: 8px 12px;
    color: cyan;
    font-weight: 500;
    text-align: left;
}

.ac-table td {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 7px 12px;
}

.ac-table tr:hover td {
    background-color: rgba(0, 255, 255, 0.05);
}

.ac-table-mono td, .ac-table-mono th {
    font-family: monospace;
    font-size: 0.85rem;
}

.ac-code {
    background-color: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(0, 255, 255, 0.2);
    border-radius: 10px;
    padding: 1.5rem;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.8rem;
    overflow-x: auto;
    line-height: 1.6;
}
.ac-positive {
    color: #00e676;
}

.ac-negative {
    color: #ff5252;
}

.ac-note {
    display: inline-block;
    border: 1px solid rgba(0, 255, 255, 0.4);
    border-radius: 20px;
    padding: 6px 24px;
    color: cyan;
    font-size: 1rem;
    letter-spacing: 0.05em;
}
</style>
    {% endblock %}
</head>
<body>
    <main>
        {% block body %}{% endblock %}
    </main>


    <footer class="mt-5 py-3 text-center text-light" style="background-color:#0b021b;">
        <small>
            © {{ "now"|date("Y") }} Constant D'huissel ·
            <a href="mailto:dhuisseconstant@gmail.com" class="text-decoration-none text-info">Me contacter</a>
        </small>
    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>